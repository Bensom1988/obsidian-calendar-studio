{
  "name": "obsidian-calendar-studio",
  "version": "0.1.0",
  "description": "An Apple-inspired, bilingual calendar for Obsidian that unifies vault dates, tasks and external CalDAV calendars, and drives your note workflows.",
  "main": "main.js",
  "license": "MIT",
  "keywords": [
    "obsidian",
    "calendar",
    "caldav",
    "lunar",
    "tasks",
    "journal"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node scripts/deploy.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ical.js": "^2.2.1",
    "lunar-javascript": "^1.7.7",
    "rrule": "^2.8.1",
    "tsdav": "^2.5.0"
  }
}
